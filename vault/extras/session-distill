#!/usr/bin/env python3
"""session-distill — turn a week of archived sessions into one durable note.

usage: session-distill

Reads the last 7 days of vault/Conversations/ exports (up to 20 files, first
6 KB of each) and asks `claude -p` for a per-project summary: decisions
made, open threads, things learned, and what the next session should know.
Writes vault/Distill/YYYY-MM-DD.md (today's date). Future sessions are
pointed at Distill/ by the global CLAUDE.md stub, so last week's state is one
Read away instead of 20 transcripts away. Silent — writes a file, messages
nobody. Typical cron: weekly (Monday morning).
"""
import glob
import os
import subprocess
import sys
import time
from datetime import date

VAULT = os.path.expanduser(os.environ.get("VAULT_DIR", "~/vault"))
OUT_DIR = os.path.join(VAULT, "Distill")
DAYS, MAX_FILES, HEAD = 7, 20, 6000

cutoff = time.time() - DAYS * 86400
convos = sorted(
    (p for p in glob.glob(os.path.join(VAULT, "Conversations", "*.md"))
     if os.path.getmtime(p) > cutoff),
    key=os.path.getmtime, reverse=True,
)
if not convos:
    print("session-distill: no sessions in the last 7 days — nothing to do")
    sys.exit(0)
skipped = max(0, len(convos) - MAX_FILES)
convos = convos[:MAX_FILES]

parts = []
for p in convos:
    with open(p, errors="replace") as f:
        parts.append(f"=== {os.path.basename(p)} ===\n{f.read()[:HEAD]}")
corpus = "\n\n".join(parts)

prompt = (
    f"Below are {len(convos)} Claude Code session transcripts from the last {DAYS} days "
    "(each truncated). Write a markdown note that a future session can read in one "
    "minute to know where things stand. Group by project (the `- project:` line in "
    "each transcript). For each project: **Decisions** (what was settled and why), "
    "**Open threads** (unfinished work, unanswered questions, known bugs), **Learned** "
    "(facts about the code/setup that took effort to discover). Then a final section "
    "**Next session should know** — at most 5 bullets across all projects. Be concrete: "
    "file paths, names, numbers. Omit anything that is not durable past this week. "
    "Never include tokens, passwords, or keys even if they appear in the transcripts. "
    "No preamble; start with the first project heading.\n\n" + corpus
)

r = subprocess.run(["claude", "-p", prompt], capture_output=True, text=True, cwd=VAULT, stdin=subprocess.DEVNULL)
if r.returncode != 0:
    sys.exit(f"session-distill: claude -p failed:\n{r.stderr}")

os.makedirs(OUT_DIR, exist_ok=True)
out = os.path.join(OUT_DIR, f"{date.today()}.md")
note = (
    f"# Distill — week ending {date.today()}\n\n"
    f"generated by session-distill from {len(convos)} sessions"
    + (f" ({skipped} older ones skipped)" if skipped else "") + "\n\n"
    + r.stdout.strip() + "\n"
)
with open(out, "w") as f:
    f.write(note)
print(f"session-distill: {len(convos)} sessions → {out}")
