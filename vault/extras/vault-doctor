#!/usr/bin/env python3
"""vault-doctor — mechanical consistency check of the vault.

usage: vault-doctor

Finds broken [[wiki-links]], broken relative markdown links, unclosed YAML
frontmatter, and orphan notes (no inbound wiki-links; root-level files and
Conversations/ don't count as orphans). Writes Meta/vault_doctor.md and
prints a summary. Typical cron: daily.
"""
import json
import os
import re
import sys
import time

VAULT = os.path.expanduser(os.environ.get("VAULT_DIR", "~/vault"))
SKIP_DIRS = {".git", ".obsidian", ".claude", ".vault"}

pages = {}   # relpath -> text
for root, dirs, files in os.walk(VAULT):
    dirs[:] = [d for d in dirs if d not in SKIP_DIRS and not d.startswith(".")]
    for fn in files:
        if fn.endswith(".md"):
            p = os.path.join(root, fn)
            with open(p, errors="replace") as f:
                pages[os.path.relpath(p, VAULT)] = f.read()

names = {os.path.splitext(os.path.basename(p))[0] for p in pages}
wiki = re.compile(r"\[\[([^\]|#]+)")
mdlink = re.compile(r"\]\(([^)]+\.md)\)")

broken_wiki, broken_md, bad_fm = [], [], []
linked = set()
for rel, text in pages.items():
    for target in wiki.findall(text):
        t = target.strip()
        linked.add(t)
        if t not in names:
            broken_wiki.append(f"{rel}: [[{t}]]")
    for target in mdlink.findall(text):
        if target.startswith(("http://", "https://")):
            continue
        base = os.path.dirname(os.path.join(VAULT, rel))
        if not os.path.isfile(os.path.normpath(os.path.join(base, target))):
            broken_md.append(f"{rel}: ({target})")
    if text.startswith("---\n") and "\n---" not in text[4:][:4000]:
        bad_fm.append(rel)

orphans = sorted(
    rel for rel in pages
    if os.sep in rel                                  # root-level files exempt
    and not rel.startswith(("Conversations", "Meta"))
    and os.path.splitext(os.path.basename(rel))[0] not in linked
)

# module audit: what is cron'd, and when it last produced anything. Modules
# whose artifact never moves are candidates for removal at the check-in.
ARTIFACTS = {
    "vault-sync": ".git/logs/HEAD",
    "save-convo": "RECENT.md",
    "vault-organizer": "Inbox",
    "vault-doctor": "Meta/vault_doctor.md",
    "session-distill": "Distill",
    "refine-prefs": "coding_prefs.md",
    "calendar-sync": "Calendar.md",
    "todoist-tasks": "Tasks.md",
}


def newest(path):
    if path == "project-context":            # newest CLAUDE.local.md across configured repos
        cfg = os.path.expanduser("~/.vault/projects.json")
        if not os.path.isfile(cfg):
            return None
        with open(cfg) as f:
            repos = [r for m in json.load(f).values() for r in m["repos"]]
        ts = [newest(os.path.join(os.path.expanduser(r), "CLAUDE.local.md")) for r in repos]
        ts = [t for t in ts if t]
        return max(ts) if ts else None
    if not os.path.isabs(path):
        path = os.path.join(VAULT, path)
    if os.path.isfile(path):
        return os.path.getmtime(path)
    if os.path.isdir(path):
        ts = [os.path.getmtime(os.path.join(path, f)) for f in os.listdir(path)]
        return max(ts) if ts else None
    return None


audit = []
template = os.path.expanduser("~/.vault/crontab.template")
if os.path.isfile(template):
    with open(template) as f:
        cron = [ln for ln in f if ln.strip() and not ln.lstrip().startswith(("#", "PATH"))]
    for ln in cron:
        fields = ln.split()
        sched = " ".join(fields[:5])
        cmd = next((w for w in fields[5:] if not w.endswith("vault-run-if-primary")), "?")
        name = os.path.basename(cmd)
        tracked = name in ARTIFACTS or name == "project-context"
        t = newest(ARTIFACTS.get(name, name)) if tracked else None
        age = "no artifact tracked" if not tracked else (
            "never written" if t is None else f"last wrote {int((time.time() - t) / 3600)}h ago")
        audit.append(f"`{name}` · {sched} · {age}")

os.makedirs(os.path.join(VAULT, "Meta"), exist_ok=True)
report = os.path.join(VAULT, "Meta", "vault_doctor.md")
with open(report, "w") as f:
    f.write("# vault doctor\n\ngenerated by vault-doctor — do not hand-edit\n")
    for title, items in (
        ("Broken wiki-links", broken_wiki),
        ("Broken markdown links", broken_md),
        ("Unclosed frontmatter", bad_fm),
        ("Orphan notes (no inbound wiki-links)", orphans),
        ("Installed cron modules (from ~/.vault/crontab.template)", audit),
    ):
        f.write(f"\n## {title} ({len(items)})\n")
        f.writelines(f"- {i}\n" for i in items)

print(f"{len(pages)} notes: {len(broken_wiki)} broken wiki-links, "
      f"{len(broken_md)} broken md links, {len(bad_fm)} bad frontmatter, "
      f"{len(orphans)} orphans → {report}")
